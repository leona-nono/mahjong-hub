{
  "name": "mahjong-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Rainbow-themed mahjong elimination game collection (clean-room replica, no 3rd-party source copied).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:tiles": "node scripts/generate-mahjong-tile-webp.mjs",
    "assets:solitaire": "node scripts/generate-solitaire-tile-placeholders.mjs",
    "sync:mahjong-set": "npx tsx scripts/sync-mahjong-set-art.ts",
    "sync:cocos-connect": "node scripts/sync-cocos-connect.mjs",
    "catalog:solitaire": "npx tsx scripts/build-solitaire-catalog.ts",
    "validate:blog-i18n": "npx tsx scripts/validate-blog-i18n-json.ts",
    "validate:content-i18n": "npx tsx scripts/validate-content-i18n.ts",
    "validate:games": "npx tsx scripts/validate-games.ts",
    "verify:en": "npx tsx scripts/verify-en-json-parity.ts",
    "lint:zh-prose": "npx tsx scripts/i18n/lint-zh-prose.ts",
    "lint:untranslated": "npx tsx scripts/i18n/lint-untranslated.ts",
    "validate:zh-prose": "npx tsx scripts/i18n/lint-zh-prose.ts --errors-only --max-density 3 --min-chars 800",
    "i18n:spec": "npx tsx scripts/i18n/localization-spec.ts --markdown",
    "gate:i18n": "npm run validate:blog-i18n && npm run validate:content-i18n && npm run validate:games && npm run validate:zh-prose && vitest run tests/blog-i18n-structure.test.ts tests/content-i18n-integrity.test.ts tests/article-links.test.ts tests/article-tiles.test.ts",
    "gate": "npm run verify:en && npm run gate:i18n && npm run test",
    "i18n:check": "npx tsx scripts/i18n-check.ts",
    "i18n:studio": "scripts/open-i18n-studio.cmd",
    "translate:content-i18n": "npx tsx scripts/i18n/translate-content-i18n.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^1.1.1",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.25",
    "next-intl": "^3.26.0",
    "nodemailer": "^6.10.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
