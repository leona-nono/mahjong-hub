{
  "name": "mahjong-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Rainbow-themed mahjong elimination game collection (clean-room replica, no 3rd-party source copied).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "esbuild scripts/seed-games.ts --bundle --platform=node --format=cjs --external:@prisma/client --outfile=node_modules/.cache/seed-games.cjs && node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.cache/seed-games.cjs",
    "assets:tiles": "node scripts/generate-mahjong-tile-webp.mjs",
    "assets:solitaire": "node scripts/generate-solitaire-tile-placeholders.mjs",
    "sync:cocos-connect": "node scripts/sync-cocos-connect.mjs",
    "catalog:solitaire": "npx tsx scripts/build-solitaire-catalog.ts",
    "validate:blog-i18n": "npx tsx scripts/validate-blog-i18n-json.ts",
    "validate:content-i18n": "npx tsx scripts/validate-content-i18n.ts",
    "translate:content-i18n": "npx tsx scripts/i18n/translate-content-i18n.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^1.1.1",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.25",
    "next-intl": "^3.26.0",
    "nodemailer": "^6.10.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
