// Prisma schema for the mahjong-hub backend.
// Models follow the standard Auth.js (NextAuth v5) Prisma adapter contract
// (User / Account / Session / VerificationToken) plus our domain extensions:
//   • ActionLog         – append-only behavior log (maps to legacy PointTransaction table)
//   • DailyBonus        – "claimed today" marker for the daily check-in
//   • LearningStat      – career learning counters (not a currency)
//   • AchievementUnlock – badge ownership; rewards grant AppearanceUnlock rows
//
// On Vercel, set DATABASE_URL to a Neon Postgres connection string
// (Neon's free tier is sufficient for this workload). Schema is Postgres-only
// because we need enums, transactions, and JSONB in future iterations.

generator client {
  provider = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth.js standard tables ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  actionLogs        ActionLog[]
  dailyBonus        DailyBonus?
  itemLedger        ItemLedger[]
  solitaireProgress SolitaireProgress[]
  solitaireDaily    SolitaireDaily[]
  solitaireStreak   SolitaireStreak?
  appearanceUnlocks AppearanceUnlock[]
  learningStat      LearningStat?
  achievements      AchievementUnlock[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Domain extensions (behavior log + daily bonus + achievements) ─────────

/// Append-only behavior log. Not a currency ledger.
/// Maps to the legacy PointTransaction table (reason→action, amount→value).
model ActionLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   @map("reason")
  value     Int      @map("amount") // keep NOT NULL; write 0 when unused
  meta      Json?
  gameSlug  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action, createdAt])
  @@index([action, createdAt])
  @@map("PointTransaction")
}

model DailyBonus {
  userId        String   @id
  lastClaimDate DateTime
  streak        Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SolitaireProgress {
  userId    String
  levelId   String
  stars     Int       @default(0)
  bestScore Int       @default(0)
  clearedAt DateTime?
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, levelId])
  @@index([userId])
}

model SolitaireDaily {
  userId      String
  utcDate     String
  cleared     Boolean  @default(false)
  score       Int      @default(0)
  stars       Int      @default(0)
  awarded     Boolean  @default(false)
  hintUsed    Int      @default(0)
  undoUsed    Int      @default(0)
  shuffleUsed Int      @default(0)
  rescueUsed  Int      @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, utcDate])
  @@index([userId])
}

model SolitaireStreak {
  userId         String   @id
  dailyStreak    Int      @default(0)
  lastDailyDate  String?
  freezeWeekKey  String?
  highestLevel   Int      @default(0)
  lessonsCleared Int      @default(0)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Append-only solitaire item ledger. Balance = SUM(delta) per (userId, itemType).
model ItemLedger {
  id        String   @id @default(cuid())
  userId    String
  itemType  String // hint | undo | shuffle | rescue
  delta     Int
  reason    String // starter | buy | consume | ad_grant | grant
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, itemType])
  @@index([userId, createdAt])
}

/// Wardrobe ownership — Foundation free rows are not stored; only unlocked skins.
model AppearanceUnlock {
  userId       String
  appearanceId String
  source       String // seasonal_checkin | achievement | legacy | grant
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, appearanceId])
  @@index([userId])
}

/// Per-user learning counters. NOT a currency — there is no spendable balance.
/// Streak lives on SolitaireStreak / DailyBonus — intentionally absent here.
model LearningStat {
  userId         String   @id
  handsPlayed    Int      @default(0)
  discardsPlayed Int      @default(0)
  coachFeedbacks Int      @default(0)
  bestGrades     Int      @default(0)
  patternsSeen   Json?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AchievementUnlock {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@index([userId])
}
