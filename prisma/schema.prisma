// Prisma schema for the mahjong-hub backend.
// Models follow the standard Auth.js (NextAuth v5) Prisma adapter contract
// (User / Account / Session / VerificationToken) plus our domain extensions:
//   • UserPoint       – running total per user (single row per user)
//   • PointTransaction– append-only ledger for audit + anti-cheat limits
//   • DailyBonus      – "claimed today" marker for the daily reward
//
// On Vercel, set DATABASE_URL to a Neon Postgres connection string
// (Neon's free tier is sufficient for this workload). Schema is Postgres-only
// because we need enums, transactions, and JSONB in future iterations.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth.js standard tables ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  point        UserPoint?
  transactions PointTransaction[]
  dailyBonus   DailyBonus?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Domain extensions (points ledger + daily bonus) ───────────────────────

model UserPoint {
  userId    String   @id
  total     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  gameSlug  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reason, createdAt])
}

model DailyBonus {
  userId        String   @id
  lastClaimDate DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}