// Prisma schema for the mahjong-hub backend.
// Models follow the standard Auth.js (NextAuth v5) Prisma adapter contract
// (User / Account / Session / VerificationToken) plus our domain extensions:
//   • UserPoint       – running total per user (single row per user)
//   • PointTransaction– append-only ledger for audit + anti-cheat limits
//   • DailyBonus      – "claimed today" marker for the daily reward
//
// On Vercel, set DATABASE_URL to a Neon Postgres connection string
// (Neon's free tier is sufficient for this workload). Schema is Postgres-only
// because we need enums, transactions, and JSONB in future iterations.

generator client {
  provider = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth.js standard tables ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  point        UserPoint?
  transactions PointTransaction[]
  dailyBonus   DailyBonus?
  itemLedger   ItemLedger[]
  solitaireProgress SolitaireProgress[]
  solitaireDaily    SolitaireDaily[]
  solitaireStreak   SolitaireStreak?
  appearanceUnlocks AppearanceUnlock[]
  fragmentLedger    FragmentLedger[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Domain extensions (points ledger + daily bonus) ───────────────────────

model UserPoint {
  userId    String   @id
  total     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  gameSlug  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reason, createdAt])
}

model DailyBonus {
  userId        String   @id
  lastClaimDate DateTime
  streak        Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SolitaireProgress {
  userId    String
  levelId   String
  stars     Int       @default(0)
  bestScore Int       @default(0)
  clearedAt DateTime?
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, levelId])
  @@index([userId])
}

model SolitaireDaily {
  userId    String
  utcDate   String
  cleared   Boolean  @default(false)
  score     Int      @default(0)
  stars     Int      @default(0)
  awarded   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, utcDate])
  @@index([userId])
}

model SolitaireStreak {
  userId         String   @id
  dailyStreak    Int      @default(0)
  lastDailyDate  String?
  freezeWeekKey  String?
  highestLevel   Int      @default(0)
  lessonsCleared Int      @default(0)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Append-only solitaire item ledger. Balance = SUM(delta) per (userId, itemType).
model ItemLedger {
  id        String   @id @default(cuid())
  userId    String
  itemType  String // hint | undo | shuffle | rescue
  delta     Int
  reason    String // starter | buy | consume | ad_grant | grant
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, itemType])
  @@index([userId, createdAt])
}

/// Wardrobe ownership — Foundation free rows are not stored; only unlocked skins.
model AppearanceUnlock {
  userId       String
  appearanceId String
  source       String // seasonal_checkin | points | fragments | grant
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, appearanceId])
  @@index([userId])
}

/// Limited-edition fragment ledger. Balance = SUM(delta) per (userId, fragmentId).
model FragmentLedger {
  id         String   @id @default(cuid())
  userId     String
  fragmentId String
  delta      Int
  reason     String // checkin_week | craft | grant
  weekKey    String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, fragmentId])
  @@unique([userId, fragmentId, weekKey, reason])
}

// ── FaWeb 运营后台扩展 (Site/Game/FAQ/Features/i18n/Themes) ──────────
// 对标 fafafa.ai 建站模板的 JSON 配置驱动+表单式无代码+每语言内容分离范式
// 96 游戏 × 18 语言规模，DB 化后可通过网页表单读写替代手动改 JSON

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique // 'general' | 'seo' | 'social' | 'analytics'
  value       Json     @db.JsonB
  updatedAt   DateTime @updatedAt
}

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique // URL slug, e.g. 'aloha-mahjong'
  title       String   // default title (en)
  description String?
  iframeUrl   String?  // iframe embed URL
  downloadUrl String?  // optional download link
  thumbnail   String?  // primary cover / card image path or URL
  screenshots String[] @default([]) // gallery images for game detail pages
  category    String?  // e.g. 'mahjong', 'tile', 'match'
  tags        String[] // e.g. ['classic','relax']
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faqs     GameFaq[]
  features GameFeature[]
}

model GameFaq {
  id        String   @id @default(cuid())
  gameId    String
  locale    String   // e.g. 'en', 'ja', 'zh-TW'
  question  String
  answer    String   // plain text or simple HTML
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, locale])
}

model GameFeature {
  gameId    String
  locale    String   // e.g. 'en', 'ja', 'zh-TW'
  content   String   // MDX (markdown with JSX components) — long-form rich text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, locale])
  @@index([gameId, locale])
}

model ThemePreset {
  id         String   @id @default(cuid())
  name       String   @unique
  colors     Json     @db.JsonB // { primary, secondary, accent, background, ... }
  fonts      Json?    @db.JsonB // { heading, body }
  cssVars    Json?    @db.JsonB // custom CSS variables
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MessageI18n {
  id        String   @id @default(cuid())
  key       String   // dot-path key like 'navbar.home'
  locale    String   // 'en', 'ja', 'ko', 'zh-TW', 'zh-CN', ...
  value     String   // translated text
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
  @@index([locale])
}

/// Beginner / Mahjong for Beginners guides. CMS overlay on top of static blog posts.
model Guide {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String?
  content      String   @db.Text
  cover        String?
  ctaLabel     String?
  ctaHref      String?
  readMinutes  Int      @default(5)
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Product-owned American Mahjong practice-card drafts. `groups` is the
/// versioned DSL payload; official NMJL card content must never be stored here.
model AmericanPracticeCard {
  id          String   @id
  version     String
  title       String
  difficulty  String
  points      Int
  description String
  groups      Json     @db.JsonB
  concealed   Boolean  @default(false)
  status      String   @default("draft") // draft | published | retired
  seasonIds   String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, updatedAt])
}
