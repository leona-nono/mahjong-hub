# ── OAuth credentials for the login module ──────────────────────────────
# Copy this file to `.env.local` and fill in real values for the providers
# you want to enable. Any provider left blank automatically falls back to the
# built-in mock login, so the site still runs locally without credentials.
#
# IMPORTANT: never commit `.env.local`. It is git-ignored. On Vercel, set these
# as Environment Variables in the project dashboard instead.

# Google Identity Services — Web application OAuth client id (public, client-safe)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Facebook Login — App ID (public, client-safe)
NEXT_PUBLIC_FACEBOOK_APP_ID=

# X (Twitter) OAuth2 — client id (public, client-safe)
NEXT_PUBLIC_X_CLIENT_ID=

# X client secret — SERVER ONLY. Must NOT be prefixed NEXT_PUBLIC_ and must
# never reach the browser bundle. Used by /api/auth/x/token to exchange the
# PKCE code for an access token.
X_CLIENT_SECRET=
