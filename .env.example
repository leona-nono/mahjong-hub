# Example environment variables for local development and Vercel.
# Copy this file to `.env` (Prisma CLI) and `.env.local` (Next.js).
# Never commit real secrets.

# Neon / Postgres connection string
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# Required on Vercel (and some local proxies) so Auth.js trusts the forwarded host
AUTH_TRUST_HOST="true"

# OAuth providers (optional; fill in after creating apps in each platform)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
AUTH_X_ID=""
AUTH_X_SECRET=""

# Email magic-link login (mainland-China friendly, no OAuth app needed)
# AUTH_EMAIL_SERVER: SMTP URL. Password special chars MUST be URL-encoded
#   (@ → %40, # → %23, etc). Examples:
#   QQ:    smtps://123456789%40qq.com:授权码@smtp.qq.com:465
#   163:   smtps://you%40163.com:授权码@smtp.163.com:465
#   Resend: smtps://resend:re_xxxx@smtp.resend.com:465
# AUTH_EMAIL_FROM must be allowed by that SMTP (QQ/163 = same mailbox; Resend = verified domain)
# Also set AUTH_TRUST_HOST=true and AUTH_URL=https://mahjonggame.org on Vercel
AUTH_EMAIL_SERVER=""
AUTH_EMAIL_FROM="noreply@yourdomain.com"
NEXT_PUBLIC_EMAIL_ENABLED="true"

# Comma-separated admin emails. Required in production (fail-closed).
ADMIN_EMAILS="you@example.com"

# Vercel Blob — required for persistent screenshot / cover uploads in production.
# Create a Blob store in the Vercel dashboard and copy the read/write token.
# Locally you can omit this; uploads then go to public/uploads/ (gitignored).
BLOB_READ_WRITE_TOKEN=""

# Optional: inject analytics without a per-page API call (preferred on Vercel)
NEXT_PUBLIC_GA_ID="G-61V8MK15S6"
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
# Bing Webmaster Tools HTML meta tag (msvalidate.01)
NEXT_PUBLIC_BING_VERIFICATION="51451E3156FA88DDC9C608C49C6FD0AC"

# Cocos Connect engine (MahjongCoreGame web-mobile). When true, native
# mahjong-connect mounts the iframe player at /cocos/connect/index.html.
# Sync build: npm run sync:cocos-connect
NEXT_PUBLIC_COCOS_CONNECT="false"
# Optional override if the build is hosted elsewhere:
# NEXT_PUBLIC_COCOS_CONNECT_SRC="/cocos/connect/index.html"

# Privacy / ads.txt (P0-G2). Analytics and ads stay off until cookie consent.
NEXT_PUBLIC_PRIVACY_EMAIL="privacy@mahjonggame.org"
# Set true only after an ad network is contracted. Rewarded tools stay locked until then.
NEXT_PUBLIC_ADS_ENABLED="false"
# Optional AdSense publisher id — when set, ads.txt includes a google.com DIRECT row.
ADSENSE_PUB_ID=""
# Extra ads.txt rows (one DIRECT/RESELLER line per newline).
ADS_TXT_ROWS=""
# HMAC secret for /api/reward/verify. Falls back to AUTH_SECRET.
AD_S2S_SECRET=""

# Local-only offline content i18n (scripts/i18n/*). Never used by Next.js runtime.
# DEEPSEEK_API_KEY=""

# After deploy, run once against production DATABASE_URL:
#   npx prisma migrate deploy
# If the project never used migrations, use:
#   npx prisma db push

